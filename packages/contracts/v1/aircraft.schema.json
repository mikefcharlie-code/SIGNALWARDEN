{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UCAS aircraft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aircraft_id",
    "display_name",
    "lifecycle_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "aircraft_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "lifecycle_status": {
      "enum": [
        "planned",
        "active",
        "maintenance",
        "retired"
      ]
    },
    "hardware_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  }
}
