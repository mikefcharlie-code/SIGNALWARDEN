{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UCAS maintenance record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "aircraft_id",
    "summary",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "aircraft_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "status": {
      "enum": [
        "open",
        "in_progress",
        "completed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    }
  }
}
